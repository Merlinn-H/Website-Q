---
import { getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkPicture from '../components/ArtworkPicture.astro';
import Bleed from '../components/Bleed.astro';
import { site } from '../site.config';
import { getFeatured, getWorks, workPath } from '../lib/works';

const about = await getEntry('about', 'index');
if (!about) throw new Error('src/content/about/index.md is missing.');
const { Content } = await render(about);

// Optional portrait: an image placed next to src/content/about/index.md. None, none shown.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/about/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true },
);
const portrait = Object.values(portraits)[0]?.default;
const portraitAlt = about.data.portraitAlt;
if (portrait && !portraitAlt) {
  throw new Error('Describe the portrait in "portraitAlt" in src/content/about/index.md.');
}

// Beside the statement, like a plate in a catalogue: the portrait if there is one, otherwise the
// gallery's opening work, whole, with its colours on the wall.
const work = portrait ? undefined : getFeatured(await getWorks());
const ratio = (value: number) => value.toFixed(4);

// The name is sized from its longest word, so it never runs off a phone's screen.
const letters = Math.max(...site.name.trim().split(/\s+/).map((word) => word.length));
---

<BaseLayout title="About">
  <div class:list={['about', { 'has-plate': portrait || work }]}>
    <div class="about-text">
      <h1 style={`--letters: ${letters}`}><span class="label">About</span> <span class="about-name">{site.name}</span></h1>
      <div class="statement">
        <Content />
      </div>
    </div>
    {
      portrait && portraitAlt ? (
        <figure class="portrait" style={`--ratio: ${ratio(portrait.width / portrait.height)}`}>
          <Picture
            src={portrait}
            alt={portraitAlt}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(min-width: 56em) 40vw, calc(100vw - 2rem)"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={Math.min(portrait.width, 1600)}
            fit="contain"
          />
        </figure>
      ) : (
        work && (
          <figure class="about-work" style={`--ratio: ${ratio(work.ratio)}`}>
            <div class="plate">
              <Bleed work={work} />
              <a href={workPath(work)} data-artwork-link>
                <ArtworkPicture
                  work={work}
                  priority
                  sizes={`(min-width: 56em) min(40vw, calc((100vh - 14rem) * ${ratio(work.ratio)})), min(calc(100vw - 2rem), calc((100vh - 14rem) * ${ratio(work.ratio)}))`}
                />
              </a>
            </div>
            <figcaption class="on-bleed">
              <span class="caption-numeral" aria-hidden="true">{work.numeral}</span>
              <span class="caption-title">{work.data.title}</span>
              <span class="label">{work.data.year}</span>
            </figcaption>
          </figure>
        )
      )
    }
  </div>
</BaseLayout>

<style>
  /* A catalogue page: the name set large, the statement in a narrow, airy column, and beside it
     a work hanging on the wall with its colours (or the portrait). One column on phones; text
     and plate side by side on wider screens. */
  .about {
    display: grid;
    gap: clamp(3.5rem, 10vh, 6rem) var(--gutter);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: calc(var(--page-top) + clamp(2rem, 9vh, 6rem)) var(--gutter) 0;
    overflow-x: clip;
  }

  h1 {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .about-name {
    font-size: min(clamp(3.5rem, 2rem + 8vw, 9rem), (100vw - 2 * var(--gutter)) / (var(--letters) * 0.55));
    font-style: italic;
    line-height: 0.9;
    padding-right: 0.1em;
  }

  .statement {
    max-width: 24em;
    margin-top: clamp(2rem, 6vh, 3.5rem);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .statement :global(p + p) {
    margin-top: 1.1em;
  }

  /* The work keeps its proportions and fits the screen below the menu, with room around it for
     its colours. */
  .about-work {
    --plate-h: max(14rem, 100svh - var(--page-top) - 2 * var(--bleed-size-vertical) - 6rem);

    display: grid;
    justify-items: center;
    gap: calc(1.25rem + var(--frame-gap));
    padding-block: var(--frame-gap);
  }

  .about-work .plate {
    width: min(100% - 2 * var(--frame-gap), var(--plate-h) * var(--ratio));
  }

  .about-work :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: contain;
  }

  .about-work .plate:has(a:hover) :global(.bleed) {
    opacity: min(1, var(--bleed-opacity) * 1.2);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 0.9rem;
    text-align: center;
  }

  .caption-numeral,
  .caption-title {
    font-family: var(--font-display);
    font-style: italic;
    line-height: 1.2;
  }

  .caption-numeral {
    font-size: 1.25rem;
    color: var(--colour-accent);
  }

  .caption-title {
    font-size: 1.375rem;
  }

  .portrait :global(img) {
    width: min(100%, 80svh * var(--ratio));
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: contain;
  }

  @media (min-width: 56em) {
    .has-plate {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(3rem, 7vw, 8rem);
      align-items: center;
    }

    .about-work {
      --plate-h: max(16rem, 100svh - var(--page-top) - 2 * var(--bleed-size-vertical) - 5rem);
    }
  }
</style>
