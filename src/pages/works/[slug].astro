---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkPicture from '../../components/ArtworkPicture.astro';
import Bleed from '../../components/Bleed.astro';
import Viewer from '../../components/Viewer.astro';
import { availability, getWorks, workPath, type Work } from '../../lib/works';
import { socialImageFor } from '../../lib/social';
import { isPlaceholder } from '../../lib/placeholder';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, index) => ({
    params: { slug: work.id },
    props: { work, previous: works[index - 1], next: works[index + 1] },
  }));
}

interface Props {
  work: Work;
  previous?: Work;
  next?: Work;
}

const { work, previous, next } = Astro.props;
const { title, year, medium, dimensions, status, etsyUrl, printsUrl } = work.data;
const ratio = work.ratio.toFixed(4);

// Large copy (longest side up to 3200px) for the full-screen view, and the link target
// for visitors without JavaScript.
const scale = Math.min(1, 3200 / Math.max(work.image.width, work.image.height));
const full = await getImage({
  src: work.image,
  width: Math.round(work.image.width * scale),
  format: 'webp',
  fit: 'contain',
});

// The original is offered only while it is available; prints stay whenever they exist.
const shopLinks: { label: string; href: string }[] = [];
if (status === 'available' && etsyUrl) shopLinks.push({ label: 'Original on Etsy', href: etsyUrl });
if (printsUrl) shopLinks.push({ label: 'Prints', href: printsUrl });

const description = `${[title, year].join(', ')}. ${[medium, dimensions].filter(Boolean).join(', ')}.`;
const socialImage = await socialImageFor(work);
---

<BaseLayout title={title} description={description} socialImage={socialImage}>
  <article class="work-page" data-back={`/#${work.id}`}>
    <div class="stage">
      <div class="stage-plate plate" style={`--ratio: ${ratio}`}>
        <Bleed work={work} />
        <a
          class="stage-work"
          href={full.src}
          data-astro-reload
          data-viewer-open
          data-width={full.attributes.width}
          data-height={full.attributes.height}
        >
          <ArtworkPicture
            work={work}
            priority
            sizes={`(min-width: 48em) and (min-aspect-ratio: 1/1) min(calc(100vw - 32rem), calc((100vh - 10rem) * ${ratio})), min(calc(100vw - 3.5rem), calc(max(8rem, 100vh - 26rem) * ${ratio}))`}
          />
          <span class="visually-hidden">, open full-screen view</span>
        </a>
      </div>
    </div>

    <div class="details on-bleed">
      <div class="details-head">
        <p class="numeral" aria-hidden="true">{work.numeral}</p>
        <h1 class="title">{title}</h1>
      </div>

      <dl class="facts">
        <div>
          <dt class="label">Year</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt class="label">Medium</dt>
          <dd>{medium}</dd>
        </div>
        {
          dimensions && (
            <div>
              <dt class="label">Dimensions</dt>
              <dd>{dimensions}</dd>
            </div>
          )
        }
        <div>
          <dt class="label">Availability</dt>
          <dd class:list={[{ 'is-sold': status === 'sold' }]}>{availability(status)}</dd>
        </div>
      </dl>

      {
        shopLinks.length > 0 && (
          <ul class="shop" role="list">
            {shopLinks.map(({ label, href }) => (
              <li>
                {isPlaceholder(href) ? (
                  <span class="button is-placeholder">
                    <span>{label}</span>
                    <span>{href}</span>
                  </span>
                ) : (
                  <a class="button" href={href}>
                    {label}
                    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                  </a>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav class="pager" aria-label="More works">
      {
        previous && (
          <a class="pager-link previous" href={workPath(previous)} rel="prev">
            <span class="label">
              <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
                <path d="M13 5H1.5M5 1 1 5l4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
              Previous
            </span>
            <span class="pager-title">{previous.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="pager-link next" href={workPath(next)} rel="next">
            <span class="label">
              Next
              <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
                <path d="M1 5h11.5M9 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
              </svg>
            </span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  <Viewer title={title} ratio={ratio} />
</BaseLayout>

<style>
  /* ---------------------------------------------------------------------------------------
     Everything about the work on one screen: the work itself (unframed), as large as the space
     allows, with its label (number, title, details, shop links) and the way to the previous and
     next works. Beside the label on wide screens, above it on phones and tall screens. The
     work's box is worked out from the space left for it, so it never moves while loading.
     --------------------------------------------------------------------------------------- */
  .work-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(9rem, 1fr) auto auto;
    grid-template-areas: 'stage' 'details' 'pager';
    row-gap: clamp(1rem, 2.5vh, 2rem);
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--page-top) var(--gutter) clamp(0.75rem, 2vh, 1.5rem);
    overflow-x: clip;
  }

  /* With JavaScript, a click on the empty background returns to the gallery (backdrop.ts). */
  .work-page.has-backdrop {
    cursor: zoom-out;
  }

  .work-page.has-backdrop :is(.details, .pager) {
    cursor: auto;
  }

  .stage {
    grid-area: stage;
    display: grid;
    place-items: center;
    min-height: 0;
    container-type: size;
  }

  .stage-plate {
    width: min(100cqw, 100cqh * var(--ratio));
  }

  @supports not (width: 1cqh) {
    .stage-plate {
      width: min(100%, 55vh * var(--ratio));
    }
  }

  .stage-work {
    cursor: zoom-in;
    view-transition-name: artwork;
  }

  .stage-work :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: contain;
  }

  /* The bleed travels with the work during page transitions (see global.css). */
  .stage-plate :global(.bleed) {
    view-transition-name: artwork-bleed;
  }

  .stage-plate:has(.stage-work:hover) :global(.bleed) {
    opacity: min(1, var(--bleed-opacity) * 1.2);
  }

  .details {
    grid-area: details;
    display: grid;
    align-content: start;
    gap: clamp(0.75rem, 2vh, 1.5rem);
  }

  .details-head {
    display: grid;
    gap: 0.5rem;
  }

  .numeral {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1;
    color: var(--colour-accent);
  }

  .numeral::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .title {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3.25rem);
    font-style: italic;
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--colour-line);
  }

  .facts div {
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }

  .facts dd {
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .is-sold {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  /* The gallery convention: a small dot marks a sold work. */
  .is-sold::before {
    content: '';
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--colour-accent);
  }

  .shop {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .shop :global(.button) {
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
  }

  .pager {
    grid-area: pager;
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--gutter);
    padding-top: clamp(0.5rem, 1.5vh, 1rem);
    border-top: 1px solid var(--colour-line);
  }

  .pager-link {
    display: grid;
    gap: 0.25rem;
    max-width: 45%;
    padding-block: 0.25rem;
    text-decoration: none;
  }

  .pager-link.next {
    margin-left: auto;
    justify-items: end;
    text-align: right;
  }

  .pager-link .label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: color 0.3s ease;
  }

  .pager-link:hover .label {
    color: var(--colour-accent);
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.1;
  }

  /* Phones: the pager keeps its labels only; the titles stay available to screen readers. */
  @media (max-width: 47.99em) {
    .pager-title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Wide screens: the work beside its label, like a painting and its wall label. */
  @media (min-width: 48em) and (min-aspect-ratio: 1/1) {
    .work-page {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 24rem);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: 'stage details' 'pager pager';
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .details {
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .details {
      animation: details-in 1.1s var(--ease-out) 0.15s both;
    }
  }

  @keyframes details-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
