---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { isPlaceholder } from '../lib/placeholder';

const { email, etsyShopUrl, printsUrl } = site.contact;

// Values still marked [PLACEHOLDER: ...] are shown as text instead of broken links.
const channels = [
  { label: 'Email', value: email, href: `mailto:${email}`, text: email, external: false },
  { label: 'Original works', value: etsyShopUrl, href: etsyShopUrl, text: 'Etsy shop', external: true },
  { label: 'Prints', value: printsUrl, href: printsUrl, text: 'Print shop', external: true },
];
---

<BaseLayout
  title="Contact"
  description="How to get in touch, and where to find original works and prints."
>
  <div class="contact">
    <h1 class="label">Contact</h1>
    <dl>
      {
        channels.map(({ label, value, href, text, external }) => (
          <div>
            <dt class="label">{label}</dt>
            <dd>
              {isPlaceholder(value) ? (
                <span>{value}</span>
              ) : (
                <a href={href}>
                  {text}
                  {external && (
                    <svg width="14" height="14" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="0.9" />
                    </svg>
                  )}
                </a>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>

<style>
  .contact {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: calc(var(--page-top) + clamp(2rem, 10vh, 7rem)) var(--gutter) 0;
  }

  dl {
    display: grid;
    gap: clamp(2rem, 6vh, 3.5rem);
    margin-top: 2.5rem;
  }

  dd {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  dd a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration-color: var(--colour-line);
  }

  dd a:hover {
    text-decoration-color: currentColor;
  }
</style>
