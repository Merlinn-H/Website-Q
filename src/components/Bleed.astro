---
import sharp from 'sharp';
import type { Work } from '../lib/works';

interface Props {
  work: Work;
}

const { work } = Astro.props;

// A tiny copy of the artwork, 8 pixels wide, so each pixel along an edge is the average colour of
// a whole stretch of that edge. CSS stretches its outermost rows and columns outwards on every
// side, blurs them and fades them out, so the colours of the work's edges wash onto the page. It
// always sits behind the work, never over it (see global.css). The same copy gives the room light
// its colour (src/scripts/light.ts). It is written into the page itself (a few hundred bytes), so
// the colours are there with the very first frame, before any image file has arrived.
const tiny = await sharp(`.${work.imagePath}`).rotate().resize({ width: 8 }).toColourspace('srgb').png().toBuffer();
const src = `data:image/png;base64,${tiny.toString('base64')}`;
---

<span class="bleed" aria-hidden="true" style={`border-image-source: url(${src})`}></span>
