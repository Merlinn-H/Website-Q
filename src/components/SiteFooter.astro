---
import { site } from '../site.config';

interface Props {
  /** One slim line, for pages that fit on one screen (the work pages). */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/cookies/', label: 'Cookies' },
  { href: '/legal/', label: 'Legal' },
];
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { compact }]}>
  <nav aria-label="Legal">
    <ul role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p>© {year} {site.name}</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(6rem, 16vh, 10rem);
    padding: 2rem var(--gutter) 2.5rem;
    border-top: 1px solid var(--colour-line);
    font-size: var(--text-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--colour-text-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  a {
    display: inline-block;
    padding-block: 0.5rem;
    text-decoration: none;
  }

  a[aria-current='page'] {
    color: var(--colour-text);
  }

  .compact {
    flex-wrap: nowrap;
    gap: 1rem;
    height: var(--footer-slim);
    margin-top: 0;
    padding-block: 0;
    border-top: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  .compact ul {
    flex-wrap: nowrap;
    gap: 0 clamp(0.75rem, 3vw, 1.5rem);
  }

  .compact p {
    white-space: nowrap;
  }
</style>
