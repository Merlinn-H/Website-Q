---
import { Picture } from 'astro:assets';
import type { Work } from '../lib/works';

interface Props {
  work: Work;
  /** Displayed width, so the browser downloads a file of the right size. */
  sizes: string;
  /** Load straight away with high priority: only for the main image at the top of a page. */
  priority?: boolean;
}

const { work, sizes, priority = false } = Astro.props;

// Resized copies made for every artwork, close enough together that each screen gets a file only a
// little larger than it needs (a phone showing a work 355px wide at 1.75x density needs 621px: it
// takes the 640px copy, not a 720px one). Sizes larger than the original are skipped.
const widths = [400, 480, 560, 640, 720, 800, 960, 1120, 1280, 1440, 1600, 2000, 2560];
---

<Picture
  src={work.image}
  alt={work.data.title}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  width={Math.min(work.image.width, 1600)}
  fit="contain"
  priority={priority}
/>
