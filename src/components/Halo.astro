---
import { getImage } from 'astro:assets';
import type { Work } from '../lib/works';

interface Props {
  work: Work;
  class?: string;
}

const { work, class: className } = Astro.props;

// A tiny copy of the artwork (a few hundred bytes) that CSS blurs into a glow of the work's own
// colours. It always sits behind the artwork, never over it (styles in global.css).
const tiny = await getImage({ src: work.image, width: 24, format: 'webp', quality: 70 });
---

<span class:list={['halo', className]} aria-hidden="true" style={`background-image: url(${tiny.src})`}></span>
