---
import { site } from '../site.config';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>

  {/* On small screens the links sit in a popover opened by this button: it works without JavaScript. */}
  <button class="menu-open label" type="button" popovertarget="site-menu">Menu</button>

  <nav id="site-menu" class="site-nav" popover aria-label="Main">
    <button class="menu-close label" type="button" popovertarget="site-menu" popovertargetaction="hide">
      Close
    </button>
    <ul role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    /* Stays still while pages change (see the page transitions in global.css). */
    view-transition-name: site-header;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5rem;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.25rem;
  }

  .site-nav a {
    display: inline-block;
    padding-block: 0.5rem;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    color: var(--colour-accent);
  }

  .menu-open,
  .menu-close {
    display: none;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: var(--colour-text);
    cursor: pointer;
  }

  .menu-open:hover,
  .menu-close:hover {
    color: var(--colour-accent);
  }

  /* Wide screens: the navigation is always visible, whatever the popover state. */
  @media (min-width: 48em) {
    .site-nav {
      display: block;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      background: none;
      color: inherit;
    }
  }

  /* Small screens: collapse the links behind the Menu button where popovers are supported.
     Older browsers ignore this block and show the links in place. */
  @supports selector(:popover-open) {
    @media (max-width: 47.99em) {
      .menu-open {
        display: inline-block;
      }

      .site-nav:popover-open {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: var(--header-h) var(--gutter) calc(var(--header-h) * 1.5);
        border: 0;
        background: var(--colour-bg-raised);
        color: var(--colour-text);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .menu-close {
        display: inline-block;
        position: absolute;
        top: calc((var(--header-h) - 2.75rem) / 2);
        right: var(--gutter);
      }

      .site-nav ul {
        flex-direction: column;
        gap: 1.25rem;
      }

      .site-nav a {
        font-family: var(--font-display);
        font-size: var(--text-title);
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.1;
        text-transform: none;
      }
    }

    @media (max-width: 47.99em) and (prefers-reduced-motion: no-preference) {
      .site-nav:popover-open {
        transition:
          opacity 0.35s ease,
          display 0.35s allow-discrete,
          overlay 0.35s allow-discrete;
      }

      @starting-style {
        .site-nav:popover-open {
          opacity: 0;
        }
      }
    }
  }

  /* Without popover support on small screens, the links wrap below the name. */
  @supports not selector(:popover-open) {
    @media (max-width: 47.99em) {
      .site-header {
        flex-wrap: wrap;
        height: auto;
        padding-block: 1rem;
      }
    }
  }
</style>
