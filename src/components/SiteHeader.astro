---
import { site } from '../site.config';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

{/* Stays at the top of the screen on every page, with every tab one tap away, phones included. */}
<header class="site-header">
  <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>

  <nav class="site-nav" aria-label="Main">
    <ul role="list">
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
    padding-inline: var(--gutter);
  }

  /* A soft shade from the top of the screen, so the menu stays readable over the works as the
     page scrolls beneath it. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -1.5rem;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--colour-bg) 92%, transparent) 55%,
      transparent
    );
    pointer-events: none;
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-brand);
    font-style: italic;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5rem;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1.1rem, 5vw, 2.25rem);
  }

  .site-nav a {
    display: inline-block;
    padding-block: 0.75rem;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    color: var(--colour-accent);
  }

  /* The narrowest phones: slightly tighter letters, so the three tabs always fit. */
  @media (max-width: 22.5em) {
    .site-nav a {
      letter-spacing: 0.1em;
    }
  }
</style>
